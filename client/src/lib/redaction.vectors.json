[
  {
    "name": "same IP same placeholder",
    "redact": true,
    "in": "connect 192.0.2.100:9120 then 192.0.2.99 then 192.0.2.100",
    "out": "connect <ip-1>:9120 then <ip-2> then <ip-1>"
  },
  {
    "name": "bracketed IPv6 keeps its port",
    "redact": true,
    "in": "peer [fe80::1]:9120",
    "out": "peer [<ip-1>]:9120"
  },
  {
    "name": "MAC address",
    "redact": true,
    "in": "mac 0c:fe:45:aa:bb:cc up",
    "out": "mac <mac> up"
  },
  {
    "name": "console serial",
    "redact": true,
    "in": "{\"serial\":\"AJ123456789012\"}",
    "out": "{\"serial\":\"<serial>\"}"
  },
  {
    "name": "home folders",
    "redact": true,
    "in": "/Users/alice/Library/x and C:\\Users\\bob\\x and /home/amy/y",
    "out": "~/Library/x and ~\\x and ~/y"
  },
  {
    "name": "secrets go even with redaction off",
    "redact": false,
    "in": "{\"pairing_key\":\"abcd\",\"ip\":\"10.0.0.9\"}",
    "out": "{\"pairing_key\":\"<removed>\",\"ip\":\"10.0.0.9\"}"
  },
  {
    "name": "key=value secrets",
    "redact": false,
    "in": "token=abc123 next",
    "out": "token=<removed> next"
  },
  {
    "name": "account id",
    "redact": false,
    "in": "\"account_id\": \"0x1234abcd\"",
    "out": "\"account_id\": \"<removed>\""
  },
  {
    "name": "versions and long dotted runs are not IPs",
    "redact": true,
    "in": "version 6.5.2 and 1.2.3.4.5",
    "out": "version 6.5.2 and 1.2.3.4.5"
  },
  {
    "name": "redaction off leaves addresses",
    "redact": false,
    "in": "192.0.2.100 at /Users/me/x",
    "out": "192.0.2.100 at /Users/me/x"
  },
  {
    "name": "multibyte text around everything",
    "redact": true,
    "in": "⚠ token=x 多 /Users/a/b ✓ 192.168.0.1 é",
    "out": "⚠ token=<removed> 多 ~/b ✓ <ip-1> é"
  },
  {
    "name": "an address after a word and a dot",
    "redact": true,
    "in": "ps5upload.bugReportDraft.192.0.2.100 and v1.2.3.4.5",
    "out": "ps5upload.bugReportDraft.<ip-1> and v1.2.3.4.5"
  },
  {
    "name": "wake keys inside escaped JSON go even with redaction off",
    "redact": false,
    "in": "\"ps5upload.roster.v1\": \"{\\\"wake_credential\\\":\\\"c-123\\\",\\\"wake_regist_key\\\":\\\"rk\\\",\\\"wake_rp_key\\\":\\\"rp\\\",\\\"name\\\":\\\"Pro\\\"}\"",
    "out": "\"ps5upload.roster.v1\": \"{\\\"wake_credential\\\":\\\"<removed>\\\",\\\"wake_regist_key\\\":\\\"<removed>\\\",\\\"wake_rp_key\\\":\\\"<removed>\\\",\\\"name\\\":\\\"Pro\\\"}\""
  },
  {
    "name": "Windows home folders inside JSON text",
    "redact": true,
    "in": "{\"dir\":\"C:\\\\Users\\\\bob\\\\Games\",\"log\":\"D:\\\\Users\\\\amy\"}",
    "out": "{\"dir\":\"~\\\\Games\",\"log\":\"~\"}"
  },
  {
    "name": "Windows home folders inside a stored JSON string",
    "redact": true,
    "in": "\"ps5upload.dest\": \"{\\\"dir\\\":\\\"C:\\\\\\\\Users\\\\\\\\bob\\\\\\\\x\\\"}\"",
    "out": "\"ps5upload.dest\": \"{\\\"dir\\\":\\\"~\\\\\\\\x\\\"}\""
  },
  {
    "name": "an older helper's Remote Play PIN line",
    "redact": false,
    "in": "[remoteplay] [ps5upload] Remote Play PIN: 14928144\n[remoteplay] Remote Play PIN expired",
    "out": "[remoteplay] [ps5upload] Remote Play PIN: <removed>\n[remoteplay] Remote Play PIN expired"
  },
  {
    "name": "a PIN in JSON, as a string and as a number",
    "redact": false,
    "in": "{\"pin\":\"14928144\",\"n\":1} {\"pin\": 14928144} {\"pinned\":\"12345678\"}",
    "out": "{\"pin\":\"<removed>\",\"n\":1} {\"pin\": <removed>} {\"pinned\":\"12345678\"}"
  },
  {
    "name": "Remote Play morning and a passcode by name",
    "redact": false,
    "in": "{\"morning\":\"0a1b2c3d\",\"passcode\":\"1234\"} morning=0a1b2c3d",
    "out": "{\"morning\":\"<removed>\",\"passcode\":\"<removed>\"} morning=<removed>"
  },
  {
    "name": "a quote escaped earlier in the line does not hide a secret",
    "redact": false,
    "in": "{\"message\":\"a 5\\\" drive\",\"detail\":{\"token\":\"SECRET2\"}}",
    "out": "{\"message\":\"a 5\\\" drive\",\"detail\":{\"token\":\"<removed>\"}}"
  },
  {
    "name": "an odd number of quotes before the key",
    "redact": false,
    "in": "it said \"no, \"token\": \"abc\" end",
    "out": "it said \"no, \"token\": \"<removed>\" end"
  },
  {
    "name": "a secret with an escaped quote goes whole",
    "redact": false,
    "in": "{\"password\":\"ab\\\"cd\",\"x\":\"y\"}",
    "out": "{\"password\":\"<removed>\",\"x\":\"y\"}"
  },
  {
    "name": "a secret ending in an escaped backslash stops at its own quote",
    "redact": false,
    "in": "{\"password\":\"ab\\\\\",\"x\":\"y\"}",
    "out": "{\"password\":\"<removed>\",\"x\":\"y\"}"
  },
  {
    "name": "a secret cut short goes to the end of its line",
    "redact": false,
    "in": "{\"token\":\"abc\nnext line \"x\":\"y\"",
    "out": "{\"token\":\"<removed>\nnext line \"x\":\"y\""
  },
  {
    "name": "escaped JSON: a quote inside an earlier value does not hide a secret",
    "redact": false,
    "in": "\"store\": \"{\\\"note\\\":\\\"a 5\\\\\\\" drive\\\",\\\"token\\\":\\\"SECRET\\\",\\\"n\\\":\\\"v\\\"}\"",
    "out": "\"store\": \"{\\\"note\\\":\\\"a 5\\\\\\\" drive\\\",\\\"token\\\":\\\"<removed>\\\",\\\"n\\\":\\\"v\\\"}\""
  },
  {
    "name": "escaped JSON: a secret with an escaped quote or backslash goes whole",
    "redact": false,
    "in": "\"store\": \"{\\\"token\\\":\\\"ab\\\\\\\"cd\\\",\\\"psk\\\":\\\"ef\\\\\\\\\\\",\\\"n\\\":\\\"v\\\"}\"",
    "out": "\"store\": \"{\\\"token\\\":\\\"<removed>\\\",\\\"psk\\\":\\\"<removed>\\\",\\\"n\\\":\\\"v\\\"}\""
  },
  {
    "name": "escaped JSON: a secret cut short stops where the outer string does",
    "redact": false,
    "in": "\"store\": \"{\\\"token\\\":\\\"abc\", \"next\": \"kept\"",
    "out": "\"store\": \"{\\\"token\\\":\\\"<removed>\", \"next\": \"kept\""
  },
  {
    "name": "a serial after an escaped quote",
    "redact": true,
    "in": "{\"name\":\"my \\\"Pro\\\"\",\"serial\":\"AJ123456789012\"}",
    "out": "{\"name\":\"my \\\"Pro\\\"\",\"serial\":\"<serial>\"}"
  }
]
