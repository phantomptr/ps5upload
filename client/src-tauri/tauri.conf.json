{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS5Upload",
  "version": "12.4.14",
  "identifier": "com.phantomptr.ps5upload",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PS5Upload",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http: https: ws: wss:; img-src 'self' data: asset: http: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' ipc: http: https: ws: wss:; img-src 'self' data: asset: http: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "category": "DeveloperTool",
    "shortDescription": "The all-in-one PS5 companion app.",
    "longDescription": "The all-in-one PS5 companion app.",
    "copyright": "© PhantomPtr, GPL-3.0",
    "license": "GPL-3.0-or-later",
    "publisher": "PhantomPtr",
    "homepage": "https://github.com/phantomptr/ps5upload",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-ps5upload-dualsense.rules": "70-ps5upload-dualsense.rules"
        },
        "depends": [
          "libasound2"
        ],
        "recommends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ]
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-ps5upload-dualsense.rules": "70-ps5upload-dualsense.rules"
        },
        "depends": [
          "alsa-lib"
        ],
        "recommends": [
          "gstreamer1-plugin-openh264",
          "gstreamer1-plugin-libav",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ps5upload"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "ps5upload"
          ],
          "appLink": false
        }
      ]
    }
  }
}
