<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the home-screen icon, as on Android. -->
	<key>CFBundleDisplayName</key>
	<string>PS5Upload</string>
	<!-- The app's Documents folder shows in the Files app: put games there to send them. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Plain http to the PS5 and to the in-app engine on 127.0.0.1. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Remote Play voice chat (experimental). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to other players through your PS5 while you use Remote Play.</string>
	<!-- Game Mode for Remote Play (iOS and iPadOS 18+): on while the app fills the screen.
	     LSSupportsGameMode is the iOS 26 key; GCSupportsGameMode is what iOS 18 reads. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>
	<!-- Remote Play screenshots and clips saved to Photos (add-only: the app never reads them). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save your Remote Play screenshots and clips to Photos.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your PS5 on your home network to send games and manage the console.</string>
</dict>
</plist>
