<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Play Together: Scan QR in Join a friend reads the invite's QR code. -->
	<key>NSCameraUsageDescription</key>
	<string>Scan the QR code of a friend's Play Together invite.</string>
	<!-- Remote Play voice chat (experimental): the page asks for the mic; macOS shows this. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to other players through your PS5 while you use Remote Play.</string>
	<!-- Game Mode for Remote Play (macOS 14+): the Mac turns it on by itself for an app in
	     the games category while that app is full screen, and off when it leaves full screen.
	     LSSupportsGameMode is the macOS 26 key; GCSupportsGameMode is what macOS 14 and 15
	     read. Merged over the Info.plist Tauri writes (bundle.macOS.infoPlist). -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>
</dict>
</plist>
