# /etc/ps5upload-hub.env (VPS setup). Every HUB_* setting with its default is in
# src/config.rs; only what differs from the defaults is needed here.

# Caddy proxies to this; never expose it directly.
HUB_HTTP_LISTEN=127.0.0.1:8787
# Caddy is on the same box: believe its X-Forwarded-For (its last entry is the client).
HUB_TRUSTED_PROXIES=127.0.0.1,::1
HUB_CLIENT_IP_HEADER=x-forwarded-for

# Optional STUN server. Off by default (clients use public STUN servers). To run it, uncomment
# and open 3478/udp in the firewall:
#HUB_STUN_LISTEN=[::]:3478

# Limits (defaults shown):
#HUB_MAX_GUESTS_PER_ROOM=8
#HUB_MAX_SIGNALS_PER_GUEST=20
#HUB_MAX_SIGNALS_PER_HOST=200
#HUB_MAX_JOINS_PER_IP=30
#HUB_MAX_ROOMS=5000
#HUB_MAX_ROOMS_PER_IP=8
#HUB_MAX_CONNECTIONS=2000
#HUB_MAX_CONNECTIONS_PER_IP=32
# Per IPv6 /48 (a client is an IPv4 address or an IPv6 /64):
#HUB_MAX_CONNECTIONS_PER_V6_SITE=256
#HUB_HELLO_SECS=10
#HUB_MAX_STUN_PER_IP=60
#HUB_ROOM_IDLE_SECS=120
#HUB_ALLOWED_ORIGINS=https://ps5upload.phantomptr.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
