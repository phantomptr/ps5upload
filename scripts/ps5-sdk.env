# SQLite amalgamation vendored into the payload (payload/third_party/sqlite3).
#
# 3.46.1 is the version ps5-payload-dev/pacbrew-repo builds for prospero, so
# it is the release with the most on-console evidence behind it. Fetched and
# checksum-verified by install-ps5-sdk.sh rather than committed: the
# amalgamation is a 9 MB generated file that never changes between pins.
PS5_SQLITE_VERSION=3460100
PS5_SQLITE_YEAR=2024
PS5_SQLITE_SHA256=77823cb110929c2bcb0f5d48e4833b5c59a8a6e40cdea3936b99e199dbbe5784
